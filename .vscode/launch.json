{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Sonny",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/sonny",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "externalConsole": false
        }
    ]
}